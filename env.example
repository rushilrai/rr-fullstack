# Copy the relevant section into each app's own .env file.

# apps/backend
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/app
# comma-separated allowed origins (used outside development)
CORS_ORIGINS=

# apps/webapp (points at apps/backend)
VITE_BACKEND_URL=http://localhost:4000

# apps/web-convex (points at the packages/convex deployment)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# apps/fullstack-convex (points at its embedded convex deployment)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# apps/native (points at the packages/convex deployment)
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
