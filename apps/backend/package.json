{
  "name": "@monorepo/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "build": "tsc",
    "start": "bun dist/app.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@monorepo/dto": "workspace:*",
    "drizzle-orm": "^0.44.6",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.9",
    "pg": "^8.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.5"
  }
}
